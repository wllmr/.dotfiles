# Keep upstream defaults and existing personal SCM Breeze preferences.
source "$HOME/.scm_breeze/git.scmbrc.example"
[[ -r "$HOME/.git.scmbrc.local" ]] && source "$HOME/.git.scmbrc.local"

# Machine-local repository root selected by the installer (plain path, not code).
if [[ -r "$HOME/.config/dotfiles/scm-repo-dir" ]]; then
  scm_repo_dir="$(< "$HOME/.config/dotfiles/scm-repo-dir")"
  [[ -z "$scm_repo_dir" ]] || export GIT_REPO_DIR="$scm_repo_dir"
  unset scm_repo_dir
fi

# SCM Breeze is the only Git-alias provider. Keep its upstream command names;
# personal settings may customize them, but standard aliases remain enabled.
export GIT_SETUP_ALIASES="yes"
